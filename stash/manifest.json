{
  "manifest_version": 3,
  "name": "Stash",
  "version": "1.1.0",
  "description": "A private, local-first bookmark manager for the web, X, Reddit and LinkedIn, with on-device AI search.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "Save to Stash (Alt+Shift+S)", "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" } },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "side_panel": { "default_path": "src/ui/panel.html" },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "contextMenus",
    "sidePanel",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.reddit.com/*",
    "https://old.reddit.com/*",
    "https://www.linkedin.com/*",
    "https://huggingface.co/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/content/x-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/content/toast.js", "src/content/x-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.reddit.com/*", "https://old.reddit.com/*"],
      "js": ["src/content/toast.js", "src/content/reddit.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["src/content/toast.js", "src/content/linkedin.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "quick-save": { "suggested_key": { "default": "Alt+Shift+S" }, "description": "Save the current page" },
    "open-panel": { "suggested_key": { "default": "Alt+Shift+K" }, "description": "Open Stash in the side panel" },
    "open-library": { "suggested_key": { "default": "Alt+Shift+L" }, "description": "Open the Stash library" }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
